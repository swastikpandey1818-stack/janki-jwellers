import 'dart:typed_data';

import 'package:flutter/material.dart';
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:printing/printing.dart';
import 'package:file_saver/file_saver.dart';

void main() {
  runApp(const ShreeJankiJewellersApp());
}

class ShreeJankiJewellersApp extends StatelessWidget {
  const ShreeJankiJewellersApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Shree Janki Jewellers',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(seedColor: const Color(0xFF9B741F)),
        useMaterial3: true,
      ),
      home: const BillingScreen(),
    );
  }
}

enum ItemType { gold, silver, other }

class JewelleryItem {
  final TextEditingController name = TextEditingController();
  final TextEditingController weight = TextEditingController();
  final TextEditingController otherRate = TextEditingController();
  final TextEditingController otherAmount = TextEditingController();
  final TextEditingController otherMaking = TextEditingController();

  ItemType type = ItemType.gold;

  double get weightValue => _number(weight.text);
  double get otherRateValue => _number(otherRate.text);
  double get otherAmountValue => _number(otherAmount.text);
  double get otherMakingValue => _number(otherMaking.text);

  void dispose() {
    name.dispose();
    weight.dispose();
    otherRate.dispose();
    otherAmount.dispose();
    otherMaking.dispose();
  }
}

double _number(String value) => double.tryParse(value.trim()) ?? 0;

class BillingScreen extends StatefulWidget {
  const BillingScreen({super.key});

  @override
  State<BillingScreen> createState() => _BillingScreenState();
}

class _BillingScreenState extends State<BillingScreen> {
  final customerName = TextEditingController();
  final customerPhone = TextEditingController();

  // Gold rate is entered per 10 grams. Silver rate is entered per gram.
  final goldRateController = TextEditingController(text: '70000');
  final silverRateController = TextEditingController(text: '100');
  final goldMakingPercentController = TextEditingController(text: '10');
  final silverMakingPercentController = TextEditingController(text: '10');
  final gstController = TextEditingController(text: '3');

  final List<JewelleryItem> items = [JewelleryItem()];

  bool makingEnabled = true;
  bool applyGst = false;
  bool busy = false;

  double get goldRatePer10g => _number(goldRateController.text);
  double get silverRatePerGram => _number(silverRateController.text);
  double get goldMakingPercent => _number(goldMakingPercentController.text);
  double get silverMakingPercent => _number(silverMakingPercentController.text);
  double get gstPercentage => _number(gstController.text);

  double metalRateFor(JewelleryItem item) {
    switch (item.type) {
      case ItemType.gold:
        return goldRatePer10g / 10;
      case ItemType.silver:
        return silverRatePerGram;
      case ItemType.other:
        return item.otherRateValue;
    }
  }

  double amountFor(JewelleryItem item) {
    if (item.type == ItemType.other) {
      // For Others, the seller enters the final item amount manually.
      return item.otherAmountValue;
    }
    return item.weightValue * metalRateFor(item);
  }

  double makingFor(JewelleryItem item) {
    if (!makingEnabled) return 0;

    switch (item.type) {
      case ItemType.gold:
        return amountFor(item) * goldMakingPercent / 100;
      case ItemType.silver:
        return amountFor(item) * silverMakingPercent / 100;
      case ItemType.other:
        // Other items use a seller-entered fixed making amount.
        return item.otherMakingValue;
    }
  }

  double get jewelleryTotal =>
      items.fold(0, (sum, item) => sum + amountFor(item));

  double get makingTotal =>
      items.fold(0, (sum, item) => sum + makingFor(item));

  double get subtotal => jewelleryTotal + makingTotal;
  double get gstAmount => applyGst ? subtotal * gstPercentage / 100 : 0;
  double get grandTotal => subtotal + gstAmount;

  String money(double value) => 'Rs. ${value.toStringAsFixed(2)}';

  void addItem() {
    setState(() => items.add(JewelleryItem()));
  }

  void removeItem(int index) {
    if (items.length == 1) return;
    setState(() {
      items[index].dispose();
      items.removeAt(index);
    });
  }

  String itemTypeName(ItemType type) {
    switch (type) {
      case ItemType.gold:
        return 'Gold';
      case ItemType.silver:
        return 'Silver';
      case ItemType.other:
        return 'Others';
    }
  }

  String _safeFileName() {
    final raw = customerName.text.trim().isEmpty
        ? 'Customer'
        : customerName.text.trim();
    final safe = raw.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
    return 'Shree_Janki_Jewellers_${safe}_${DateTime.now().millisecondsSinceEpoch}.pdf';
  }

  Future<Uint8List> _createPdfBytes() async {
    final document = pw.Document();
    final now = DateTime.now();
    final billNumber = 'SJJ-${now.millisecondsSinceEpoch}';

    document.addPage(
      pw.MultiPage(
        pageFormat: PdfPageFormat.a4,
        margin: const pw.EdgeInsets.all(30),
        build: (context) => [
          pw.Center(
            child: pw.Text(
              'SHREE JANKI JEWELLERS',
              style: pw.TextStyle(fontSize: 23, fontWeight: pw.FontWeight.bold),
            ),
          ),
          pw.SizedBox(height: 4),
          pw.Center(child: pw.Text('Jewellery Bill')),
          pw.SizedBox(height: 20),
          pw.Row(
            mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
            children: [
              pw.Text('Bill No: $billNumber'),
              pw.Text('Date: ${now.day}/${now.month}/${now.year}'),
            ],
          ),
          pw.Divider(),
          pw.Text('Customer Details',
              style: pw.TextStyle(fontSize: 14, fontWeight: pw.FontWeight.bold)),
          pw.SizedBox(height: 6),
          pw.Text('Name: ${customerName.text.trim()}'),
          pw.Text('Mobile: ${customerPhone.text.trim().isEmpty ? "Not provided" : customerPhone.text.trim()}'),
          pw.SizedBox(height: 15),
          pw.Text('24K Gold Rate: ${money(goldRatePer10g)} per 10 grams'),
          pw.Text('Silver Rate: ${money(silverRatePerGram)} per gram'),
          pw.Text('Making Charges: ${makingEnabled ? "Enabled" : "Disabled"}'),
          if (makingEnabled)
            pw.Text('Gold Making: ${goldMakingPercent.toStringAsFixed(2)}% | Silver Making: ${silverMakingPercent.toStringAsFixed(2)}%'),
          pw.SizedBox(height: 12),
          pw.TableHelper.fromTextArray(
            headers: [
              'Description',
              'Type',
              'Weight/Qty',
              'Rate',
              'Item Amount',
              'Making',
              'Total',
            ],
            data: items.map((item) {
              final amount = amountFor(item);
              final making = makingFor(item);
              final rateText = item.type == ItemType.gold
                  ? '${money(goldRatePer10g)} / 10g'
                  : item.type == ItemType.silver
                      ? '${money(silverRatePerGram)} / g'
                      : money(item.otherRateValue);
              final weightText = item.type == ItemType.other
                  ? (item.weight.text.trim().isEmpty ? '-' : item.weight.text.trim())
                  : '${item.weightValue.toStringAsFixed(2)} g';
              return [
                item.name.text.trim().isEmpty ? 'Item' : item.name.text.trim(),
                itemTypeName(item.type),
                weightText,
                rateText,
                money(amount),
                money(making),
                money(amount + making),
              ];
            }).toList(),
            headerStyle: pw.TextStyle(fontWeight: pw.FontWeight.bold, fontSize: 7),
            cellStyle: const pw.TextStyle(fontSize: 7),
            headerDecoration: const pw.BoxDecoration(color: PdfColors.amber100),
            cellAlignment: pw.Alignment.center,
            columnWidths: {
              0: const pw.FlexColumnWidth(1.3),
              1: const pw.FlexColumnWidth(0.65),
              2: const pw.FlexColumnWidth(0.8),
              3: const pw.FlexColumnWidth(1.1),
              4: const pw.FlexColumnWidth(1.0),
              5: const pw.FlexColumnWidth(0.9),
              6: const pw.FlexColumnWidth(1.0),
            },
          ),
          pw.SizedBox(height: 22),
          pw.Align(
            alignment: pw.Alignment.centerRight,
            child: pw.Container(
              width: 245,
              child: pw.Column(
                crossAxisAlignment: pw.CrossAxisAlignment.stretch,
                children: [
                  _pdfSummaryRow('Items Amount', jewelleryTotal),
                  _pdfSummaryRow('Making Charges', makingTotal),
                  pw.Divider(),
                  _pdfSummaryRow('Subtotal', subtotal),
                  _pdfSummaryRow('GST (${applyGst ? gstPercentage : 0}%)', gstAmount),
                  pw.Divider(),
                  pw.Container(
                    padding: const pw.EdgeInsets.all(9),
                    color: PdfColors.amber100,
                    child: pw.Row(
                      mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
                      children: [
                        pw.Text('GRAND TOTAL',
                            style: pw.TextStyle(fontWeight: pw.FontWeight.bold, fontSize: 12)),
                        pw.Text(money(grandTotal),
                            style: pw.TextStyle(fontWeight: pw.FontWeight.bold, fontSize: 12)),
                      ],
                    ),
                  ),
                ],
              ),
            ),
          ),
          pw.SizedBox(height: 35),
          pw.Center(
            child: pw.Text('Thank you for shopping with Shree Janki Jewellers!',
                style: pw.TextStyle(fontWeight: pw.FontWeight.bold)),
          ),
        ],
      ),
    );

    return document.save();
  }

  pw.Widget _pdfSummaryRow(String label, double value) {
    return pw.Padding(
      padding: const pw.EdgeInsets.symmetric(vertical: 4),
      child: pw.Row(
        mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
        children: [pw.Text(label), pw.Text('Rs. ${value.toStringAsFixed(2)}')],
      ),
    );
  }

  bool _validateBill() {
    if (customerName.text.trim().isEmpty) {
      _message('Please enter customer name.');
      return false;
    }
    if (items.any((item) =>
        item.weightValue < 0 ||
        item.otherRateValue < 0 ||
        item.otherAmountValue < 0 ||
        item.otherMakingValue < 0)) {
      _message('Weight, rates and amounts cannot be negative.');
      return false;
    }
    if (items.any((item) =>
        item.type == ItemType.other && item.otherAmount.text.trim().isEmpty)) {
      _message('Please enter the item amount for every Others item.');
      return false;
    }
    if (goldRatePer10g < 0 || silverRatePerGram < 0 ||
        goldMakingPercent < 0 || silverMakingPercent < 0 ||
        gstPercentage < 0) {
      _message('Rates and percentages cannot be negative.');
      return false;
    }
    return true;
  }

  void _message(String message) {
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(message)));
  }

  Future<void> sharePdf() async {
    if (!_validateBill() || busy) return;
    setState(() => busy = true);
    try {
      final bytes = await _createPdfBytes();
      await Printing.sharePdf(bytes: bytes, filename: _safeFileName());
    } catch (e) {
      _message('Could not open PDF sharing: $e');
    } finally {
      if (mounted) setState(() => busy = false);
    }
  }

  Future<void> downloadPdf() async {
    if (!_validateBill() || busy) return;
    setState(() => busy = true);
    try {
      final bytes = await _createPdfBytes();
      final name = _safeFileName().replaceAll('.pdf', '');
      await FileSaver.instance.saveFile(
        name: name,
        bytes: bytes,
        fileExtension: 'pdf',
        mimeType: MimeType.pdf,
      );
      if (mounted) _message('PDF saved successfully.');
    } catch (e) {
      _message('Could not save PDF: $e');
    } finally {
      if (mounted) setState(() => busy = false);
    }
  }

  Future<void> printPdf() async {
    if (!_validateBill() || busy) return;
    setState(() => busy = true);
    try {
      final bytes = await _createPdfBytes();
      await Printing.layoutPdf(
        onLayout: (format) async => bytes,
        name: _safeFileName(),
      );
    } catch (e) {
      _message('Could not open print preview: $e');
    } finally {
      if (mounted) setState(() => busy = false);
    }
  }

  Widget inputField(
    String label,
    TextEditingController controller, {
    TextInputType keyboardType = TextInputType.text,
  }) {
    return TextField(
      controller: controller,
      keyboardType: keyboardType,
      onChanged: (_) => setState(() {}),
      decoration: InputDecoration(
        labelText: label,
        border: const OutlineInputBorder(),
      ),
    );
  }

  Widget sectionTitle(String title) => Text(
        title,
        style: const TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
      );

  Widget summaryTile(String label, double value, {bool bold = false}) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 6),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(label,
              style: TextStyle(
                  fontWeight: bold ? FontWeight.bold : FontWeight.normal,
                  fontSize: bold ? 18 : 15)),
          Text(money(value),
              style: TextStyle(
                  fontWeight: bold ? FontWeight.bold : FontWeight.normal,
                  fontSize: bold ? 19 : 15)),
        ],
      ),
    );
  }

  @override
  void dispose() {
    customerName.dispose();
    customerPhone.dispose();
    goldRateController.dispose();
    silverRateController.dispose();
    goldMakingPercentController.dispose();
    silverMakingPercentController.dispose();
    gstController.dispose();
    for (final item in items) {
      item.dispose();
    }
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final numberKeyboard = const TextInputType.numberWithOptions(decimal: true);

    return Scaffold(
      appBar: AppBar(
        title: const Text('Shree Janki Jewellers',
            style: TextStyle(fontWeight: FontWeight.bold)),
        backgroundColor: const Color(0xFF9B741F),
        foregroundColor: Colors.white,
      ),
      body: Center(
        child: ConstrainedBox(
          constraints: const BoxConstraints(maxWidth: 950),
          child: ListView(
            padding: const EdgeInsets.all(20),
            children: [
              sectionTitle('Customer Details'),
              const SizedBox(height: 12),
              inputField('Customer Name', customerName),
              const SizedBox(height: 12),
              inputField('Mobile Number', customerPhone,
                  keyboardType: TextInputType.phone),
              const SizedBox(height: 25),

              sectionTitle('Daily Rates & Making Charges'),
              const SizedBox(height: 12),
              inputField('24K Gold Rate per 10 grams (Rs.)', goldRateController,
                  keyboardType: numberKeyboard),
              const SizedBox(height: 12),
              inputField('Silver Rate per gram (Rs.)', silverRateController,
                  keyboardType: numberKeyboard),
              const SizedBox(height: 8),
              SwitchListTile(
                contentPadding: EdgeInsets.zero,
                title: const Text('Enable Making Charges'),
                subtitle: const Text('Turn off to remove making charges from all items.'),
                value: makingEnabled,
                onChanged: (value) => setState(() => makingEnabled = value),
              ),
              if (makingEnabled) ...[
                Row(
                  children: [
                    Expanded(
                      child: inputField('Gold Making (%)', goldMakingPercentController,
                          keyboardType: numberKeyboard),
                    ),
                    const SizedBox(width: 10),
                    Expanded(
                      child: inputField('Silver Making (%)', silverMakingPercentController,
                          keyboardType: numberKeyboard),
                    ),
                  ],
                ),
              ],
              const SizedBox(height: 25),

              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  sectionTitle('Jewellery / Items'),
                  FilledButton.icon(
                    onPressed: addItem,
                    icon: const Icon(Icons.add),
                    label: const Text('Add Item'),
                  ),
                ],
              ),
              const SizedBox(height: 12),

              ...items.asMap().entries.map((entry) {
                final index = entry.key;
                final item = entry.value;
                final amount = amountFor(item);
                final making = makingFor(item);
                return Card(
                  margin: const EdgeInsets.only(bottom: 15),
                  child: Padding(
                    padding: const EdgeInsets.all(15),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.stretch,
                      children: [
                        Row(
                          children: [
                            Expanded(
                              child: Text('Item ${index + 1}',
                                  style: const TextStyle(
                                      fontWeight: FontWeight.bold, fontSize: 17)),
                            ),
                            IconButton(
                              onPressed: () => removeItem(index),
                              icon: const Icon(Icons.delete_outline, color: Colors.red),
                            ),
                          ],
                        ),
                        DropdownButtonFormField<ItemType>(
                          value: item.type,
                          decoration: const InputDecoration(
                            labelText: 'Item Type',
                            border: OutlineInputBorder(),
                          ),
                          items: const [
                            DropdownMenuItem(value: ItemType.gold, child: Text('Gold')),
                            DropdownMenuItem(value: ItemType.silver, child: Text('Silver')),
                            DropdownMenuItem(value: ItemType.other, child: Text('Others (Pearls, Gems, etc.)')),
                          ],
                          onChanged: (value) {
                            if (value != null) setState(() => item.type = value);
                          },
                        ),
                        const SizedBox(height: 10),
                        TextField(
                          controller: item.name,
                          onChanged: (_) => setState(() {}),
                          decoration: const InputDecoration(
                            labelText: 'Item Description / Name',
                            border: OutlineInputBorder(),
                          ),
                        ),
                        const SizedBox(height: 10),
                        if (item.type == ItemType.gold || item.type == ItemType.silver) ...[
                          TextField(
                            controller: item.weight,
                            keyboardType: numberKeyboard,
                            onChanged: (_) => setState(() {}),
                            decoration: const InputDecoration(
                              labelText: 'Weight in grams',
                              border: OutlineInputBorder(),
                            ),
                          ),
                          const SizedBox(height: 10),
                          Text(
                            item.type == ItemType.gold
                                ? 'Gold calculation rate: ${money(goldRatePer10g / 10)} per gram'
                                : 'Silver calculation rate: ${money(silverRatePerGram)} per gram',
                            style: const TextStyle(color: Colors.black54),
                          ),
                        ] else ...[
                          TextField(
                            controller: item.weight,
                            keyboardType: numberKeyboard,
                            onChanged: (_) => setState(() {}),
                            decoration: const InputDecoration(
                              labelText: 'Weight / Quantity (optional)',
                              border: OutlineInputBorder(),
                            ),
                          ),
                          const SizedBox(height: 10),
                          TextField(
                            controller: item.otherRate,
                            keyboardType: numberKeyboard,
                            onChanged: (_) => setState(() {}),
                            decoration: const InputDecoration(
                              labelText: 'Rate (optional, for reference) Rs.',
                              border: OutlineInputBorder(),
                            ),
                          ),
                          const SizedBox(height: 10),
                          TextField(
                            controller: item.otherAmount,
                            keyboardType: numberKeyboard,
                            onChanged: (_) => setState(() {}),
                            decoration: const InputDecoration(
                              labelText: 'Item Amount set by seller (Rs.)',
                              border: OutlineInputBorder(),
                            ),
                          ),
                          if (makingEnabled) ...[
                            const SizedBox(height: 10),
                            TextField(
                              controller: item.otherMaking,
                              keyboardType: numberKeyboard,
                              onChanged: (_) => setState(() {}),
                              decoration: const InputDecoration(
                                labelText: 'Making / Extra Charge set by seller (Rs.)',
                                border: OutlineInputBorder(),
                              ),
                            ),
                          ],
                        ],
                        const SizedBox(height: 12),
                        Align(
                          alignment: Alignment.centerRight,
                          child: Text(
                            'Item Amount: ${money(amount)}\n'
                            'Making Charges: ${money(making)}\n'
                            'Item Total: ${money(amount + making)}',
                            textAlign: TextAlign.right,
                            style: const TextStyle(fontWeight: FontWeight.bold),
                          ),
                        ),
                      ],
                    ),
                  ),
                );
              }),

              const SizedBox(height: 15),
              Card(
                color: Colors.amber.shade50,
                child: Padding(
                  padding: const EdgeInsets.all(18),
                  child: Column(
                    children: [
                      sectionTitle('Bill Summary'),
                      const SizedBox(height: 15),
                      summaryTile('Items Amount', jewelleryTotal),
                      summaryTile('Making Charges', makingTotal),
                      const Divider(),
                      summaryTile('Subtotal', subtotal),
                      SwitchListTile(
                        contentPadding: EdgeInsets.zero,
                        title: const Text('Apply GST'),
                        value: applyGst,
                        onChanged: (value) => setState(() => applyGst = value),
                      ),
                      if (applyGst) ...[
                        inputField('GST Percentage', gstController,
                            keyboardType: numberKeyboard),
                        const SizedBox(height: 8),
                        summaryTile('GST Amount', gstAmount),
                      ],
                      const Divider(),
                      summaryTile('GRAND TOTAL', grandTotal, bold: true),
                    ],
                  ),
                ),
              ),
              const SizedBox(height: 22),
              SizedBox(
                height: 52,
                child: FilledButton.icon(
                  onPressed: busy ? null : sharePdf,
                  icon: const Icon(Icons.share),
                  label: Text(busy ? 'PLEASE WAIT...' : 'SHARE PDF / WHATSAPP'),
                ),
              ),
              const SizedBox(height: 10),
              SizedBox(
                height: 52,
                child: OutlinedButton.icon(
                  onPressed: busy ? null : downloadPdf,
                  icon: const Icon(Icons.download),
                  label: const Text('DOWNLOAD PDF'),
                ),
              ),
              const SizedBox(height: 10),
              SizedBox(
                height: 52,
                child: OutlinedButton.icon(
                  onPressed: busy ? null : printPdf,
                  icon: const Icon(Icons.print),
                  label: const Text('PRINT / PREVIEW BILL'),
                ),
              ),
              const SizedBox(height: 20),
            ],
          ),
        ),
      ),
    );
  }
}
